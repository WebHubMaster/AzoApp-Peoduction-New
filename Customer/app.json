{
  "expo": {
    "name": "AzoApp Customer",
    "slug": "azoapp-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "azoappcustomer",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.azoapp.customer",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "AzoApp uses speech recognition for voice search.",
        "NSMicrophoneUsageDescription": "AzoApp uses the microphone for voice search.",
        "UIBackgroundModes": [
          "remote-notification",
          "audio"
        ]
      }
    },
    "android": {
      "package": "app.azoapp.homeservice",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D47A1"
      },
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "USE_FULL_SCREEN_INTENT",
        "SYSTEM_ALERT_WINDOW",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "SCHEDULE_EXACT_ALARM"
      ],
      "googleServicesFile": "./google-services.json",
      "backgroundColor": "#0D47A1"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-audio",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "./plugins/withFirebaseBomPin.js",
      "./plugins/withJobRingAndroid.js",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1666D3",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AzoApp uses your location to show services available in your area."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "AzoApp uses the microphone for voice search.",
          "speechRecognitionPermission": "AzoApp uses speech recognition for voice search."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#0D47A1",
          "resizeMode": "contain",
          "imageWidth": 240,
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#0D47A1"
          }
        }
      ],
      "expo-sharing",
      "./plugins/withAutoVersionName.js"
    ],
    "experiments": {
      "typedRoutes": false,
      "baseUrl": "/api/customer"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "14a48255-07fc-4879-9d63-cab47ed22a0c"
      }
    },
    "owner": "emergent_chandan"
  }
}
