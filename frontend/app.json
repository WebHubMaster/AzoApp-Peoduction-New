{
  "expo": {
    "name": "AzoApp Partner",
    "slug": "azoapp-partner",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "azoapppartner",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.azoapp.partner",
      "infoPlist": {
        "NSCameraUsageDescription": "Capture KYC documents and job photos",
        "NSPhotoLibraryUsageDescription": "Upload documents and job proof photos",
        "NSLocationWhenInUseUsageDescription": "Detect your shop and service address",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification",
          "audio"
        ]
      }
    },
    "android": {
      "package": "app.azoapp.partner",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D47A1"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "USE_FULL_SCREEN_INTENT",
        "FOREGROUND_SERVICE_PHONE_CALL",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#0D47A1",
          "resizeMode": "contain",
          "imageWidth": 240
        }
      ],
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Detect your shop and service address"
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Upload documents and job proof photos",
          "cameraPermission": "Capture KYC documents and live job photos"
        }
      ],
      "expo-audio",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "./plugins/withFirebaseBomPin.js",
      "./plugins/withJobRingAndroid.js",
      "./plugins/withShareQueries.js",
      [
        "react-native-share",
        {
          "ios": ["whatsapp"],
          "android": ["com.whatsapp", "com.whatsapp.w4b"]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0D47A1",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-mail-composer"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1cea8872-060e-4edb-a8df-6f7e5f7e6d0e"
      }
    },
    "owner": "emergent_chandan"
  }
}
